; University Mail Bridge — VPS configuration.
;
; 1. Put your TLS certificate and key in  data/certs/  as fullchain.pem and
;    privkey.pem (see README). They are referenced below as /data/certs/...
; 2. Replace the example account addresses with your real university addresses.
;
; Multiple accounts share the same IMAP (993) and SMTP (465) ports: the proxy
; routes each client by the username it logs in with. Add one [address] section
; per mailbox. Most universities run on Microsoft 365, so the OAuth settings are
; identical for each — only the address in the section header changes.

[emailproxy]
; Don't wipe a saved sign-in just because a client presented a wrong password.
; On a public endpoint that would turn a stray probe into a lockout.
delete_account_token_on_password_error = False


; ============================ local endpoints ============================
; Clients connect here over TLS; the proxy relays to Microsoft 365.

[IMAP-993]
local_address = 0.0.0.0
server_address = outlook.office365.com
server_port = 993
local_certificate_path = /data/certs/fullchain.pem
local_key_path = /data/certs/privkey.pem

[SMTP-465]
local_address = 0.0.0.0
server_address = smtp.office365.com
server_port = 587
server_starttls = True
local_certificate_path = /data/certs/fullchain.pem
local_key_path = /data/certs/privkey.pem


; ============================== accounts =================================
; One section per mailbox. These OAuth values suit any Microsoft 365 tenant;
; copy a block and change only the address in the [ ] header to add more.

[account-one@example.com]
permission_url = https://login.microsoftonline.com/common/oauth2/v2.0/authorize
token_url = https://login.microsoftonline.com/common/oauth2/v2.0/token
oauth2_scope = https://outlook.office365.com/IMAP.AccessAsUser.All https://outlook.office365.com/SMTP.Send offline_access
redirect_uri = http://localhost:8080/
client_id = 9e5f94bc-e8a4-4e73-b8be-63364c29d753
client_secret =

[account-two@example.com]
permission_url = https://login.microsoftonline.com/common/oauth2/v2.0/authorize
token_url = https://login.microsoftonline.com/common/oauth2/v2.0/token
oauth2_scope = https://outlook.office365.com/IMAP.AccessAsUser.All https://outlook.office365.com/SMTP.Send offline_access
redirect_uri = http://localhost:8080/
client_id = 9e5f94bc-e8a4-4e73-b8be-63364c29d753
client_secret =
